#!/usr/bin/env python3
"""Apply a colorscheme from themes.json to the local dotfiles."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

if sys.version_info < (3, 11):
    sys.exit("theme requires Python 3.11 or newer")

import tomllib


CATALOG = Path(__file__).resolve().with_name("themes.json")
FZF_GROUPS = (
    ("bg+", "bg", "spinner", "hl"),
    ("fg", "header", "info", "pointer"),
    ("marker", "fg+", "prompt", "hl+"),
    ("selected-bg",),
    ("border", "label"),
)
COLOR_DEFAULTS = {
    "info": "header",
    "pointer": "hl",
    "fg+": "fg",
    "prompt": "hl",
    "hl+": "hl",
    "selected-bg": "bg+",
    "label": "fg",
}
TMUX_STYLES = {
    "mode-style": {"fg": "fg", "bg": "bg+"},
    "message-style": {"fg": "fg", "bg": "bg"},
    "message-command-style": {"fg": "fg", "bg": "bg"},
    "pane-border-style": {"fg": "border"},
    "pane-active-border-style": {"fg": "header"},
    "status-style": {"fg": "fg", "bg": "bg"},
    "window-status-style": {"fg": "header", "bg": "bg"},
    "window-status-current-style": {"fg": "bg", "bg": "header"},
    "window-status-activity-style": {"fg": "bg", "bg": "spinner"},
}


def edit_config(path, render, *, create=False):
    """Write a complete edit to the symlink target, committing it with a rename."""
    target = path.resolve()
    exists = target.is_file()
    if not exists and not create:
        return False

    old = target.read_bytes().decode("utf-8") if exists else ""
    updated = render(old)
    if updated == old:
        return False

    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as temp:
        temporary_path = Path(temp.name)
        try:
            if exists:
                os.fchmod(temp.fileno(), stat.S_IMODE(target.stat().st_mode))
            temp.write(updated.encode("utf-8"))
            temp.close()
            temporary_path.replace(target)
        finally:
            temporary_path.unlink(missing_ok=True)
    return True


def render_ghostty(config, name):
    assignment = re.compile(r"^[ \t]*theme[ \t]*=[^\n]*(?:\n|$)", re.MULTILINE)
    if not name:
        return assignment.sub("", config)
    line = f"theme = {json.dumps(name, ensure_ascii=False)}\n"
    if assignment.search(config):
        return assignment.sub(lambda _: line, config)
    first, newline, rest = config.partition("\n")
    if not config:
        return line
    return first + (newline or "\n") + line + rest


def render_tmux(config, colors, overrides):
    for option, roles in TMUX_STYLES.items():
        command = "setw" if option.startswith("window-") else "set"
        style = {key: colors[role] for key, role in roles.items()}
        style.update(overrides.get(option, {}))
        arguments = ",".join(f"{key}={color}" for key, color in style.items())
        config = re.sub(
            rf"^{command} -g {option} [^\r\n]*",
            f'{command} -g {option} "{arguments}"',
            config,
            flags=re.MULTILINE,
        )
    return config


def render_fzf(config, colors):
    continuation = " " + "\\" + "\n"
    options = continuation.join(
        "    --color=" + ",".join(f"{role}:{colors[role]}" for role in group)
        for group in FZF_GROUPS
    )
    return re.sub(r' *--color=bg\+:[^"]+"', lambda _: options + '"', config)


def render_nvim(config, scheme, mode, *, modus_variant=None, gruvbox_contrast=None):
    config = re.sub(r'vim\.o\.background = "[^"]*"', f'vim.o.background = "{mode}"', config)
    if modus_variant:
        config = re.sub(r'modus_operandi = "[^"]*"', f'modus_operandi = "{modus_variant}"', config)
    if gruvbox_contrast:
        setting = f"vim.g.gruvbox_contrast_{mode}"
        assignment = f'{setting} = "{gruvbox_contrast}"'
        existing = rf"""^([ \t]*){re.escape(setting)}[ \t]*=[ \t]*(?:"[^"]*"|'[^']*')"""
        config, count = re.subn(existing, lambda match: match[1] + assignment, config, flags=re.M)
        if not count:
            config = re.sub(
                r"^([ \t]*)(?=vim\.cmd\.colorscheme\()",
                lambda match: f"{match[1]}{assignment}\n{match[1]}",
                config, count=1, flags=re.M,
            )
    return re.sub(r'vim\.cmd\.colorscheme\("[^"]*"\)', f'vim.cmd.colorscheme("{scheme}")', config)


def ghostty_palette_path(config_home, name):
    for directory in (
        config_home / "ghostty/themes",
        Path("/Applications/Ghostty.app/Contents/Resources/ghostty/themes"),
    ):
        candidate = directory / name
        if candidate.is_file():
            return candidate
    return None


def mix_color(start, end, amount):
    channels = (
        int(int(start[i:i + 2], 16) * (1 - amount) + int(end[i:i + 2], 16) * amount + 0.5)
        for i in (1, 3, 5)
    )
    return "#" + "".join(f"{channel:02x}" for channel in channels)


def generate_hunk_palette(colors, mode, label, palette_path):
    text = palette_path.read_text() if palette_path else ""
    terminal = {
        role: f"#{color}"
        for role, color in re.findall(r"^\s*(background|foreground)\s*=\s*#?([0-9a-f]{6})\b", text, re.I | re.M)
    }
    ansi = {
        index: f"#{color}"
        for index, color in re.findall(r"^\s*palette\s*=\s*(\d+)\s*=\s*#?([0-9a-f]{6})\b", text, re.I | re.M)
    }
    bg = terminal.get("background", colors["bg"])
    fg = terminal.get("foreground", colors["fg"])
    accent = ansi.get("4", colors["header"])
    added = ansi.get("2", "#116329" if mode == "light" else "#3fb950")
    removed = ansi.get("1", colors["hl"])
    muted = mix_color(bg, fg, 0.70)
    added_sign = mix_color(added, fg, 0.30)
    removed_sign = mix_color(removed, fg, 0.30)
    return {
        "label": label,
        "base": f"github-{mode}-default",
        "background": bg,
        "panel": bg,
        "panelAlt": mix_color(bg, fg, 0.08),
        "border": colors["border"],
        "text": fg,
        "muted": muted,
        "accent": accent,
        "accentMuted": mix_color(bg, accent, 0.16),
        "contextBg": bg,
        "contextContentBg": bg,
        "lineNumberBg": bg,
        "lineNumberFg": muted,
        "selectedHunk": mix_color(bg, colors["bg+"], 0.55),
        "addedBg": mix_color(bg, added, 0.15),
        "addedContentBg": mix_color(bg, added, 0.28),
        "addedSignColor": added_sign,
        "badgeAdded": added_sign,
        "removedBg": mix_color(bg, removed, 0.15),
        "removedContentBg": mix_color(bg, removed, 0.28),
        "removedSignColor": removed_sign,
        "badgeRemoved": removed_sign,
        "syntax_scopes": {
            "comment": muted,
            "entity.name.tag": mix_color(ansi.get("6", colors["marker"]), fg, 0.25),
            "keyword": mix_color(accent, fg, 0.25),
            "string": mix_color(added, fg, 0.25),
            "constant.numeric": mix_color(ansi.get("3", colors["spinner"]), fg, 0.25),
            "constant.language": mix_color(ansi.get("5", colors["spinner"]), fg, 0.25),
        },
    }


def render_hunk(config, name, palette):
    # Patch the root key and our own tables in place, then validate the entire
    # document so an unfamiliar TOML layout cannot overwrite other settings.
    expected = tomllib.loads(config)
    setting = f'theme = "{name}"'
    if "theme" in expected:
        root_end = re.search(r"^[ \t]*\[", config, re.MULTILINE)
        offset = root_end.start() if root_end else len(config)
        root, count = re.subn(
            r"""^[ \t]*(?:theme|"theme"|'theme')[ \t]*=[ \t]*(?:"(?:[^"\\\r\n]|\\.)*"|'[^'\r\n]*')""",
            setting,
            config[:offset],
            count=1,
            flags=re.MULTILINE,
        )
        if not count:
            raise ValueError("could not locate the root theme setting")
        config = root + config[offset:]
    else:
        config = setting + "\n" + config

    header = f"themes.{name}"
    entries = {
        header: {key: value for key, value in palette.items() if key != "syntax_scopes"},
        f"{header}.syntax_scopes": palette["syntax_scopes"],
    }
    for table, values in entries.items():
        lines = [
            f"{json.dumps(key) if table.endswith('.syntax_scopes') else key} = {json.dumps(value, ensure_ascii=False)}"
            for key, value in values.items()
        ]
        replacement = f"[{table}]\n" + "\n".join(lines) + "\n"
        pattern = (
            rf"^[ \t]*\[{re.escape(table)}\][^\r\n]*\r?\n.*?"
            r"(?=(?:^[ \t]*(?:#[^\r\n]*)?\r?\n)*(?:^[ \t]*\[|\Z))"
        )
        config, count = re.subn(pattern, lambda _: replacement, config, flags=re.M | re.S)
        if not count:
            separator = "" if config.endswith("\n\n") else "\n" if config.endswith("\n") else "\n\n"
            config += separator + replacement

    expected["theme"] = name
    expected.setdefault("themes", {})[name] = palette
    if tomllib.loads(config) != expected:
        raise ValueError("could not update the managed Hunk theme without changing other settings")
    return config


def update_hunk(path, scheme, theme, colors, mode, label, palette_path):
    if not path.is_file() and not shutil.which("hunk"):
        return
    name = f"dotfiles-{scheme}"
    palette = generate_hunk_palette(colors, mode, label, palette_path)
    palette.update(theme.get("hunk", {}))
    if edit_config(path, lambda config: render_hunk(config, name, palette), create=True):
        print(f"Updated Hunk theme: {name}")


def update_rex(name, mode, palette_path):
    rex = shutil.which("rex")
    if not rex:
        print("Rex theme skipped: rex CLI unavailable", file=sys.stderr)
        return

    def action(command, argument):
        return subprocess.run(
            [rex, "--autostart=false", "--timeout", "5s", "do", command, argument],
            capture_output=True,
            text=True,
            timeout=8,
        )

    result = action("client.appearance.switch_mode", f"mode={mode}")
    if result.returncode:
        print(f"Rex theme skipped: {(result.stderr or result.stdout).strip()}", file=sys.stderr)
        return
    result = action("client.theme.change", f"name={name}")
    if not result.returncode:
        # Rex can return success for an unavailable theme without selecting it.
        print(f"Requested Rex theme: {name}")
    elif palette_path:
        result = action("client.theme.import", f"path={palette_path}")
        if result.returncode:
            print(f"Rex theme import failed: {(result.stderr or result.stdout).strip()}", file=sys.stderr)
        else:
            print(f"Requested Rex theme import: {name}")
    else:
        message = (result.stderr or result.stdout).strip()
        print(f"Rex theme skipped: no Ghostty palette file for {name} ({message})", file=sys.stderr)


def switch_theme(scheme, theme):
    home = Path.home()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    colors = theme["colors"].copy()
    for key, role in COLOR_DEFAULTS.items():
        colors.setdefault(key, colors[role])
    mode = theme.get("background", "dark")
    ghostty = theme.get("ghostty", scheme)
    nvim = theme.get("nvim", scheme)
    terminal_name = ghostty or "One Half Dark"
    palette_path = ghostty_palette_path(config_home, terminal_name)

    edits = (
        ("Ghostty config", home / ".config/ghostty/config", lambda config: render_ghostty(config, ghostty)),
        ("tmux config", home / ".tmux.conf", lambda config: render_tmux(config, colors, theme.get("tmux", {}))),
        ("FZF colors in zshrc", home / ".zshrc", lambda config: render_fzf(config, colors)),
        ("FZF colors in minimal_zsh", home / "dotfiles/minimal_zsh", lambda config: render_fzf(config, colors)),
        ("nvim colorscheme", home / ".config/nvim/init.lua",
         lambda config: render_nvim(
             config, nvim, mode,
             modus_variant=theme.get("nvim_modus_variant"),
             gruvbox_contrast=theme.get("nvim_gruvbox_contrast"),
         )),
    )
    failed = False
    tmux_config = home / ".tmux.conf"
    for label, path, render in edits:
        try:
            if edit_config(path, render):
                print(f"Updated {label}")
            if path == tmux_config and path.is_file() and os.environ.get("TMUX"):
                subprocess.run(["tmux", "source-file", str(path.resolve())], check=True)
                print("Reloaded tmux")
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
            print(f"{label}: {error}", file=sys.stderr)
            failed = True

    try:
        update_hunk(config_home / "hunk/config.toml", scheme, theme, colors, mode, terminal_name, palette_path)
    except (OSError, ValueError, RuntimeError, TypeError) as error:
        print(f"Hunk config: {error}", file=sys.stderr)
        failed = True

    try:
        update_rex(terminal_name, mode, palette_path)
    except (OSError, subprocess.SubprocessError) as error:
        print(f"Rex theme skipped: {error}", file=sys.stderr)

    print(f"\nTheme switch incomplete: {scheme}" if failed else f"\nTheme switched to: {scheme}")
    print("\nTo complete the switch:")
    print("  1. Restart Ghostty (or open new window)")
    print("  2. Source your shell: source ~/.zshrc")
    print(f"  3. Restart nvim (or run :colorscheme {nvim})")
    return int(failed)


def main():
    catalog = json.loads(CATALOG.read_text())
    groups = {"light": [], "dark": []}
    for name, entry in catalog.items():
        groups[entry.get("background", "dark")].append(f"  {name}")
    help_list = ["Available colorschemes:"]
    for mode, names in groups.items():
        help_list.extend(("", f"{mode.title()} themes:", *names))
    parser = argparse.ArgumentParser(
        prog="theme",
        usage="%(prog)s <colorscheme>",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="\n".join(help_list),
    )
    parser.add_argument("colorscheme", metavar="<colorscheme>", choices=catalog)
    if len(sys.argv) == 1:
        parser.print_help()
        return 1
    args = parser.parse_args()
    return switch_theme(args.colorscheme, catalog[args.colorscheme])


if __name__ == "__main__":
    sys.exit(main())
